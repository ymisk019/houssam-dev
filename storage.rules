rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    match /staging/{userId}/{submissionId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId
        && ((fileName == "cover" && request.resource.size <= 5 * 1024 * 1024)
          || (fileName == "game.zip" && request.resource.size <= 25 * 1024 * 1024)
          || (fileName.matches("screenshot-[0-4]") && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType.matches("image/(jpeg|png|webp)")));
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
