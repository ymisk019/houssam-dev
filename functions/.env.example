# Non-secret runtime configuration. Copy to functions/.env.<firebase-project-id>.
FUNCTION_REGION=us-central1
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-public-game-repository
GITHUB_BRANCH=main
GITHUB_PAGES_ORIGIN=https://your-github-owner.github.io/your-repository
GEMINI_MODEL=choose-a-model-available-to-your-account
GROQ_MODEL=choose-a-model-available-to-your-account
MAX_ZIP_BYTES=26214400
MAX_COVER_BYTES=5242880
MAX_EXTRACTED_BYTES=104857600
MAX_ENTRY_BYTES=5242880
MAX_ARCHIVE_ENTRIES=200
MAX_ARCHIVE_DEPTH=12
