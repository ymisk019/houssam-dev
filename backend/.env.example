# Configure these in the Render service environment; never expose secrets to the browser.
GOOGLE_CLOUD_PROJECT=d-1288b
FRONTEND_ORIGIN=https://ymisk019.github.io
# Optional: defaults to Render's RENDER_EXTERNAL_URL. Set only for a custom domain.
# PUBLIC_API_ORIGIN=https://your-api.example.com
# On Render, add firebase-admin.json as a Secret File and set this path.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json
GITHUB_OWNER=ymisk019
GITHUB_REPO=houssam-dev-games-private
GITHUB_BRANCH=main
